    <build>
        <pluginManagement>
            <plugins>
                <!-- Lombok on the processor path here means no service can lose annotation
                     processing by editing its own pom. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                    <version>${spring-cloud-contract.version}</version>
                </plugin>
                
                <plugin>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-maven-plugin</artifactId>
                    <version>${springdoc-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>cz.habarta.typescript-generator</groupId>
                    <artifactId>typescript-generator-maven-plugin</artifactId>
                    <version>${typescript-generator.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Inherited by every module. Fails the build on a duplicate dependency declaration,
                 which is how this repository accumulated 40 of them and lost annotation-processor
                 configuration in three services. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <!-- Fails the build if a developer edits a Spring Cloud Contract but incremental compilation 
                 fails to regenerate the tests, leading to testing against stale generated code. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>check-stale-contracts</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument><![CDATA[
import glob, os, sys
contracts = glob.glob('src/test/resources/contracts/**/*.groovy', recursive=True)
if not contracts: sys.exit(0)
generated = glob.glob('target/generated-test-sources/contracts/**/*.java', recursive=True)
if not generated: sys.exit(0)
newest = max(os.path.getmtime(g) for g in generated)
stale = [c for c in contracts if os.path.getmtime(c) > newest]
for s in stale: print(f'FAIL: {s} is newer than generated tests. Please run mvn clean.')
sys.exit(1 if stale else 0)
                                ]]></argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>${specTestExcludes}</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <!-- KafkaAdmin creates topics during context refresh. With no broker running
                             it retries localhost:9092 once a second and the context just waits:
                             measured 2026-08-28, 52 failed connections and 51s of startup for
                             LedgerService MockRequestTest, which asserts one thing.

                             Set here rather than per profile because the classes that pay it declare
                             no @ActiveProfiles at all, so there is no profile file to put it in, and
                             several of their modules have no default test config either.

                             Harmless where @EmbeddedKafka supplies a real broker: that broker creates
                             topics on demand. Verified across the full reactor, 322 tests green.
                             A test that genuinely needs topic auto-creation can still override this
                             with @SpringBootTest(properties = ...), which outranks a system property. -->
                        <spring.kafka.admin.auto-create>false</spring.kafka.admin.auto-create>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn test -P specs   regenerates every module's target/openapi.json. -->
            <id>specs</id>
            <properties>
                <specTestExcludes>no/such/Path.java</specTestExcludes>
            </properties>
        </profile>
        <profile>
            <!-- CI tests profile: skips contract tests (which are handled in FoodDeliveryContracts) -->
            <id>ci-tests</id>
            <properties>
                <spring.cloud.contract.verifier.skip>true</spring.cloud.contract.verifier.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*Contract*Test.java</exclude>
                                <exclude>${specTestExcludes}</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <repositories>
        <!-- 
          Override third-party repositories that cause Maven warnings during builds.
          spring-releases (repo.spring.io/release) throws 401 Unauthorized.
          apache.snapshots (repository.apache.org/snapshots) throws blocked mirror (HTTP).
          Pointing them to Maven Central safely bypasses the warnings.
        -->
        <repository>
            <id>spring-releases</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>apache.snapshots</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    
    <pluginRepositories>
        <pluginRepository>
            <id>spring-releases</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>apache.snapshots</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!--
      Publishing only. There is deliberately no <repositories> entry here to match it.

      GitHub Packages requires authentication even to read a public package, so a resolution
      repository in this pom would make every developer's build consult an authenticated remote for
      SNAPSHOT updates, and a machine without a token would start failing builds that work today.
      Resolution lives in a CI-only settings.xml instead; local builds keep resolving from ~/.m2.

      The <id> must match the <server><id> the workflow writes, or deploy fails with a 401 that
      reads like a permissions problem rather than a configuration one.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — parthu-reddy/FoodDeliveryParentPOM</name>
            <url>https://maven.pkg.github.com/parthu-reddy/FoodDeliveryParentPOM</url>
        </repository>
    </distributionManagement>

</project>
